  "homepage": "https://github.com/classytic/labs#readme",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"styles/**/*.css\" \"*.{ts,mjs,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"styles/**/*.css\" \"*.{ts,mjs,json,css}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:conformance": "tsc -p tsconfig.conformance.json",
    "ui:check": "node scripts/check-host-ui.mjs",
    "test:unit": "vitest run tests/core.test.ts tests/catalog.test.ts tests/stage-templates.test.ts",
    "test:package": "vitest run tests/widgets.test.tsx",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gallery": "npm run build && node tests/gallery/rasterize.mjs",
    "gallery:svg": "vitest run tests/gallery.test.tsx",
    "experience:check": "npm run build && node scripts/experience-check.mjs",
    "lint": "tsc --noEmit",
    "lab:create": "node scripts/lab-create.mjs",
    "labs:generate": "node scripts/gen-manifests.mjs && node scripts/gen-render-map.mjs && node scripts/gen-activity-map.mjs && node scripts/gen-catalog.mjs && node scripts/gen-domain-blocks.mjs",
    "labs:check": "node scripts/labs-check.mjs",
    "labs:quality": "npm run build && node scripts/labs-quality.mjs",
    "labs:quality:strict": "npm run build && node scripts/labs-quality.mjs --strict",
    "package:check": "node scripts/package-check.mjs",
    "teaching:check": "node scripts/teaching-variety.mjs",
    "sync:stage": "node scripts/sync-stage.mjs",
    "styles:split": "node scripts/split-domains.mjs",
    "styles:check": "node scripts/split-domains.mjs --check",
    "tokens:export": "node scripts/export-tokens.mjs",
    "tokens:check": "node scripts/export-tokens.mjs --check",
    "collisions:check": "node tests/gallery/collision-check.mjs --strict",
    "verify": "npm run format:check && npm run labs:check && npm run styles:check && npm run tokens:check && npm run typecheck && npm test",
    "verify:release": "npm run labs:check && npm run ui:check && npm run typecheck && npm run typecheck:conformance && npm run build && node scripts/labs-quality.mjs --strict && npm run package:check && npm run styles:check && npm run tokens:check && npm run collisions:check && vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "push": "classytic-push",
    "prepublishOnly": "npm run verify:release"
  },
